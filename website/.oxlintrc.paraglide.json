{
  "plugins": [],
  "jsPlugins": [
    {
      "name": "paraglide",
      "specifier": "@inlang/paraglide-js/eslint"
    }
  ],
  "ignorePatterns": ["src/paraglide/**"],
  "rules": {
    "paraglide/no-dynamic-message-access": [
      "error",
      {
        "messageModuleDirectories": ["paraglide"]
      }
    ]
  }
}
