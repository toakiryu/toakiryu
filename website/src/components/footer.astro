---
import { GithubLogoIcon } from '@phosphor-icons/react';

import QRCode from '@/components/QRCode.astro';
import site from '@/site.config';
import { buildInfo } from '@/utils/build-info';

const items = [
  {
    title: 'Resources',
    links: [
      {
        label: 'Home',
        href: '/',
      },
      {
        label: 'Latest',
        href: '/latest',
      },
    ],
  },
];
---

<footer class="mt-24 border-t">
  <div class="container max-w-200 mx-auto px-4 py-12">
    <div class="w-full flex flex-wrap gap-8">
      <QRCode value={site.url} container="max-w-[15%]" />
      <div class="flex-1 grid gap-x-8 gap-y-9 sm:grid-cols-3">
        {items.map((item) => (
          <div>
            <h2 class="font-mono text-[11px] tracking-[0.13em] uppercase">
              {item.title}
            </h2>
            <ul class="mt-3 space-y-1.5 text-sm">
              {item.links.map((link) => (
                <li>
                  <a
                    class="text-muted-foreground hover:text-foreground no-underline font-font-heading"
                    href={link.href}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6 mt-10 border-t font-mono text-xs text-muted-foreground">
      <p>&copy; 2026 Toakiryu. All rights reserved.</p>
      <ul class="flex items-center gap-4">
        <li class="inline-flex flex-wrap items-center gap-x-1.5">
          <span>
            built <time datetime={buildInfo.datetime}>{buildInfo.date}</time>
          </span>
          <span aria-hidden="true">·</span>
          {buildInfo.url ? (
            <a
              href={buildInfo.url}
              title={
                buildInfo.commit
                  ? `公開中のコミット: ${buildInfo.commit}`
                  : undefined
              }
              class="underline underline-offset-4"
              target="_blank"
              rel="noopener noreferrer"
            >
              {buildInfo.label}
            </a>
          ) : (
            <span>{buildInfo.label}</span>
          )}
        </li>
        <li>
          <a
            class="w-fit h-fit inline-flex shrink-0 items-center justify-center rounded-none border border-transparent bg-clip-padding text-xs transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/30 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-2 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-3.5 p-1 hover:border-muted-foreground border-dotted"
            href="https://github.com/toakiryu"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <GithubLogoIcon />
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
