---
import { CalendarDotsIcon, FunnelIcon } from '@phosphor-icons/react';
import { getCollection, getEntry, render } from 'astro:content';

import {
  Shell,
  ShellActions,
  ShellBanner,
  ShellDescription,
  ShellFooter,
  ShellTitle,
} from '@/components/ui/shell';
import { localeStaticPaths } from '@/i18n/routing';
import Layout from '@/layouts/Layout.astro';
import { MergeStaticPaths } from '@/utils/static-paths';

export async function getStaticPaths() {
  const latest = await getCollection(
    'latest',
    ({ data }) => data.public === true,
  );

  const latestStaticPaths = latest.map((c) => ({
    params: { latestId: c.id },
  }));

  const paths = MergeStaticPaths(localeStaticPaths, latestStaticPaths)();
  console.log('getStaticPaths', paths);
  return paths;
}

const { latestId } = Astro.params;

const latest = await getEntry('latest', latestId);

if (!latest) {
  return Astro.redirect('/404', 302);
}

const { Content, remarkPluginFrontmatter } = await render(latest);
const { title, description, category, created_at, updated_at } = latest.data;

const date = {
  created: created_at.toDateString(),
  updated: updated_at?.toLocaleDateString() ?? created_at.toDateString(),
};
---

<Layout>
  <main class="flex-1 [--rail-width:8.5rem] [--rail-gap:3.5rem]">
    <div class="container max-w-200 px-4 mx-auto">
      <article>
        <Shell>
          <ShellBanner>Last updated: {date.updated}</ShellBanner>
          <ShellTitle>{latest.data.title}</ShellTitle>
          <ShellDescription>{latest.data.description}</ShellDescription>
          <ShellFooter className="flex flex-wrap gap-5">
            <span class="inline-flex items-center gap-1">
              <CalendarDotsIcon />
              <span class="sr-only">created at:</span>
              {date.created}
            </span>
            <span class="inline-flex items-center gap-1 capitalize">
              <span class="sr-only">category:</span>
              <FunnelIcon />
              {latest.data.category}
            </span>
          </ShellFooter>
          <div class="prose border-border mt-9 border-t pt-9">
            <Content />
          </div>
        </Shell>
      </article>
    </div>
  </main>
</Layout>
