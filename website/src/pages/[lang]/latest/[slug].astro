---
import {
  CalendarDotsIcon,
  FunnelIcon,
  MarkdownLogoIcon,
  UserIcon,
} from '@phosphor-icons/react';
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';

import {
  Shell,
  ShellBanner,
  ShellDescription,
  ShellFooter,
  ShellTitle,
} from '@/components/ui/shell';
import { localeStaticPaths } from '@/i18n/routing';
import Layout from '@/layouts/Layout.astro';
import { i18nl } from '@/utils/link';
import { getPublicPosts } from '@/utils/posts';
import { MergeStaticPaths } from '@/utils/static-paths';

export const getStaticPaths = (async () => {
  const posts = await getPublicPosts();

  const latestPaths = await Promise.all(
    posts.map(async (c) => ({
      params: { slug: c.id },
      props: {
        post: c,
        author: await getEntry(c.data.author),
      },
    })),
  );
  return MergeStaticPaths(localeStaticPaths, latestPaths)();
}) satisfies GetStaticPaths;

const { post, author } = Astro.props;

if (!post) {
  return Astro.redirect('/404', 302);
}

const { Content } = await render(post);
const { title, description, category, created_at, updated_at } = post.data;

const date = {
  created: created_at.toDateString(),
  updated: updated_at?.toLocaleDateString() ?? created_at.toDateString(),
};
---

<Layout title={title} description={description}>
  <main class="flex-1 [--rail-width:8.5rem] [--rail-gap:3.5rem]">
    <div class="container max-w-200 px-4 mx-auto">
      <article>
        <Shell>
          <ShellBanner>Last updated: {date.updated}</ShellBanner>
          <ShellTitle>{title}</ShellTitle>
          <ShellDescription>{description}</ShellDescription>
          <ShellFooter className="flex flex-col gap-5">
            <div class="flex flex-wrap gap-5">
              <span class="inline-flex items-center gap-1">
                <CalendarDotsIcon />
                <span class="sr-only">created at:</span>
                {date.created}
              </span>
              <span class="inline-flex items-center gap-1 capitalize">
                <span class="sr-only">category:</span>
                <FunnelIcon />
                {category}
              </span>
              {author && (
                <span class="inline-flex items-center gap-1 capitalize">
                  <span class="sr-only">author:</span>
                  <UserIcon />
                  {author.data.firstname.kanji} {author.data.lastname.kanji}
                </span>
              )}
            </div>
            <div class="flex flex-wrap gap-5">
              <span class="inline-flex items-center gap-1 capitalize">
                <span class="sr-only">markdown:</span>
                <a
                  class="inline-flex items-center gap-1"
                  href={i18nl('/latest', `${post.id}.md`)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <MarkdownLogoIcon size={20} />
                  Markdown
                </a>
              </span>
            </div>
          </ShellFooter>
          <div class="prose dark:prose-invert border-border mt-9 border-t pt-9 font-furifont">
            <Content />
          </div>
          <div class="border-border mt-12 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3 border-t pt-5">
            <ul class="text-faint flex flex-wrap gap-x-4 font-mono text-[11px]">
              {post.data.tags?.map((tag) => (
                <li>
                  <a
                    class="no-underline text-muted-foreground"
                    href={i18nl('/latest/tag', tag)}
                  >
                    {tag}
                  </a>
                </li>
              ))}
            </ul>
            <p class="text-sm">
              <a
                href={i18nl('/latest')}
                class="text-primary underline font-heading"
              >
                All latest updates
              </a>
            </p>
          </div>
        </Shell>
      </article>
    </div>
  </main>
</Layout>
