{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "?sync:i18n": "言語設定を同期",
    "sync:i18n": "node scripts/sync-i18n.mjs",
    "?dev": "開発サーバーを起動",
    "dev": "pnpm sync:i18n && astro dev --config astro.dev.config.mjs",
    "?dev:bg": "開発サーバーをバックグラウンド起動",
    "dev:bg": "pnpm sync:i18n && astro dev --config astro.dev.config.mjs --background",
    "?dev:stop": "開発サーバーを停止",
    "dev:stop": "astro dev stop",
    "?dev:status": "開発サーバーの状態を確認",
    "dev:status": "astro dev status",
    "?dev:logs": "開発サーバーのログを表示",
    "dev:logs": "astro dev logs",
    "?build": "翻訳・型を生成してビルド",
    "build": "pnpm sync:i18n && wrangler types && astro build",
    "?preview": "ビルドしてローカル配信",
    "preview": "pnpm build && wrangler dev",
    "?deploy": "ビルドしてデプロイ",
    "deploy": "pnpm build && wrangler deploy",
    "?types": "Worker型を生成",
    "types": "wrangler types",
    "?astro": "言語設定を同期してAstro CLIを実行",
    "astro": "pnpm sync:i18n && astro",
    "?inlang": "言語設定を同期してinlang CLIを実行",
    "inlang": "pnpm sync:i18n && inlang",
    "?x18n": "言語設定を同期してX18n CLIを実行",
    "x18n": "pnpm sync:i18n && x18n",
    "?x18n:status": "翻訳の対応率・キー・診断を表示",
    "x18n:status": "pnpm sync:i18n && x18n status",
    "?x18n:check": "無効・未翻訳・未使用の翻訳キーを検査",
    "x18n:check": "pnpm sync:i18n && x18n check",
    "?x18n:doctor": "翻訳リソースとキー参照の検出設定を診断",
    "x18n:doctor": "pnpm sync:i18n && x18n doctor",
    "?x18n:ui": "翻訳を閲覧・編集するX18n UIを起動",
    "x18n:ui": "pnpm sync:i18n && x18n ui",
    "?x18n:build": "翻訳の静的レポートを生成",
    "x18n:build": "pnpm sync:i18n && x18n build",
    "?x18n:format": "翻訳リソースを整形",
    "x18n:format": "pnpm sync:i18n && x18n format",
    "?x18n:fill": "不足している翻訳キーに空の値を追加",
    "x18n:fill": "pnpm sync:i18n && x18n fill",
    "?check:i18n": "翻訳プロジェクトを検査",
    "check:i18n": "pnpm sync:i18n && inlang check --project ./project.inlang",
    "?machine-translate": "機械翻訳を実行",
    "machine-translate": "pnpm sync:i18n && inlang machine translate --project project.inlang",
    "?lint:i18n": "lintを実行（互換用）",
    "lint:i18n": "pnpm lint",
    "?lint": "コード・翻訳参照を検査",
    "lint": "oxlint",
    "?lint:fix": "安全な修正を適用",
    "lint:fix": "oxlint --fix",
    "?lint:fix:all": "提案を含む修正を適用（要差分確認）",
    "lint:fix:all": "oxlint --fix --fix-suggestions",
    "?format": "ファイルを整形",
    "format": "oxfmt --write .",
    "?format:check": "整形状態を検査",
    "format:check": "oxfmt --check .",
    "?check": "コード・整形を検査",
    "check": "pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@devframes/hub": "^1.2.6",
    "@devframes/vite": "^1.2.6",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/thesvg-color": "^1.2.20",
    "@iconify-json/vscode-icons": "^1.2.93",
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@x18n/cli": "^0.1.0",
    "@x18n/core": "^0.1.0",
    "@x18n/devtools": "^0.1.0",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "astro-meta-tags": "^0.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
