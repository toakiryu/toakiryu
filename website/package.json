{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm build && concurrently -k -n astro,worker \"pnpm dev:watch\" \"pnpm dev:worker\"",
    "dev:watch": "chokidar \"src/**/*\" \"messages/**/*\" \"astro.config.mjs\" \"project.inlang/settings.json\" -i \"src/paraglide/**\" -c \"pnpm build\"",
    "dev:worker": "wrangler dev",
    "start": "pnpm dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir './src\\paraglide' && wrangler types && astro build",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "types": "wrangler types",
    "astro": "astro",
    "check:i18n": "inlang check --project ./project.inlang",
    "machine-translate": "inlang machine translate --project project.inlang",
    "lint:i18n": "oxlint --config ./.oxlintrc.paraglide.json ."
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@types/node": "^26.6.5",
    "chokidar-cli": "^3.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
