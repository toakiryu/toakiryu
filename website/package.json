{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "?sync:i18n": "i18n.config.tsからinlangの言語設定を同期",
    "sync:i18n": "node scripts/sync-i18n.mjs",
    "?dev": "AstroとWorkerの統合開発サーバーを起動",
    "dev": "pnpm sync:i18n && astro dev --config astro.dev.config.mjs",
    "?dev:bg": "統合開発サーバーをバックグラウンドで起動",
    "dev:bg": "pnpm sync:i18n && astro dev --config astro.dev.config.mjs --background",
    "?dev:stop": "開発サーバーを停止",
    "dev:stop": "astro dev stop",
    "?dev:status": "開発サーバーの状態を確認",
    "dev:status": "astro dev status",
    "?dev:logs": "開発サーバーのログを表示",
    "dev:logs": "astro dev logs",
    "?build": "翻訳コードとWorker型を生成し、静的サイトをdistに出力",
    "build": "pnpm sync:i18n && wrangler types && astro build",
    "?preview": "ビルド後、Wranglerでローカル配信（変更監視なし）",
    "preview": "pnpm build && wrangler dev",
    "?deploy": "ビルド後、Cloudflareへデプロイ",
    "deploy": "pnpm build && wrangler deploy",
    "?types": "Wranglerの設定からWorker型を生成",
    "types": "wrangler types",
    "?astro": "言語設定を同期してからAstro CLIを実行",
    "astro": "pnpm sync:i18n && astro",
    "?inlang": "言語設定を同期してからinlang CLIを実行",
    "inlang": "pnpm sync:i18n && inlang",
    "?check:i18n": "翻訳プロジェクトを検査",
    "check:i18n": "pnpm sync:i18n && inlang check --project ./project.inlang",
    "?machine-translate": "翻訳プロジェクトの機械翻訳を実行",
    "machine-translate": "pnpm sync:i18n && inlang machine translate --project project.inlang",
    "?lint:i18n": "翻訳メッセージの参照に関するルールを検査",
    "lint:i18n": "oxlint --config ./.oxlintrc.paraglide.json .",
    "?format": "Prettierでファイルを整形",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/devicon": "^1.2.71",
    "@iconify-json/logos": "^1.2.17",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/thesvg-color": "^1.2.20",
    "@iconify-json/vscode-icons": "^1.2.93",
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "astro-meta-tags": "^0.4.1",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
